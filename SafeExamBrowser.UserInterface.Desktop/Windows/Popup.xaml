<Window x:Class="SafeExamBrowser.UserInterface.Desktop.Windows.Popup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SafeExamBrowser.UserInterface.Desktop.Windows"
        mc:Ignorable="d" AllowsTransparency="True"
        Title="Popup" Height="165" Width="800" WindowStyle="None" ResizeMode="NoResize" Background="{x:Null}">
    <Border x:Name="NotificationPopup" 
            VerticalAlignment="Bottom"      
            HorizontalAlignment="Center"
            Margin="0,0,0,-100"             
            Padding="25,12,30,12"
            Background="White" 
            CornerRadius="25"
            Visibility="Hidden"
            SnapsToDevicePixels="True">

        <Border.RenderTransform>
            <TranslateTransform x:Name="PopupTransform" Y="0"/>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" RenderingBias="Quality" ShadowDepth="3" Opacity="0.2"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="28" Height="28" Margin="0,0,15,0">
                <Ellipse x:Name="IconEllipse" Stroke="#222222" StrokeThickness="2"/>
                <TextBlock x:Name="IconText" Text="i" Foreground="#222222" FontWeight="Bold" 
                       FontSize="16" HorizontalAlignment="Center" 
                       VerticalAlignment="Center" Margin="0,-1,0,0"
                       FontFamily="Arial Rounded MT Bold"/>
            </Grid>

            <TextBlock x:Name="notificationContent" Text="System Info Notification" 
                   Foreground="#222222" 
                   FontSize="20" 
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   FontFamily="Arial Rounded MT Bold" Margin="0,0,0,3" />
        </StackPanel>
    </Border>

</Window>
