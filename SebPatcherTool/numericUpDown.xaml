<UserControl x:Class="SebPatcherTool.numericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Button Style -->
            <Style x:Key="UwpButtonStyle" TargetType="Button">

                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">

                                <ContentPresenter
                                    Focusable="False"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <!-- Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="{DynamicResource ControlHover}"/>

                                    <Setter TargetName="border"
                                            Property="BorderBrush"
                                            Value="{DynamicResource AccentBrush}"/>
                                </Trigger>

                                <!-- Pressed -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="{DynamicResource ControlPressed}"/>
                                </Trigger>

                                <!-- Disabled -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border"
                                            Property="Opacity"
                                            Value="0.5"/>
                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

        </ResourceDictionary>

    </UserControl.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="35"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="35"/>
        </Grid.ColumnDefinitions>


        <!-- Down Button -->
        <Button Grid.Column="0"
                Content="&#x2039;"
                Click="Down_Click"
                Style="{StaticResource UwpButtonStyle}"
                FontSize="18"
                Padding="0,0,0,3">

            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4,0,0,4"/>
                </Style>
            </Button.Resources>

        </Button>


        <!-- Value Display -->
        <Border Grid.Column="1"
                Background="{DynamicResource ControlBackground}"
                BorderBrush="{DynamicResource ControlBorder}"
                BorderThickness="0,1,0,1"
                PreviewMouseDown="Down_MouseDown"
                PreviewMouseUp="StopTimer">

            <TextBox x:Name="txtValue"
                     Text="0"
                     FontSize="16"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource PrimaryText}"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     PreviewTextInput="txtValue_PreviewTextInput"
                     TextChanged="txtValue_TextChanged"
                     MouseWheel="txtValue_MouseWheel"
                     SelectionBrush="{DynamicResource AccentBrush}"
                     CaretBrush="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}" BorderBrush="{x:Null}" FontFamily="Cascadia Code"/>

        </Border>


        <!-- Up Button -->
        <Button Grid.Column="2"
                Content="&#x203A;"
                Click="Up_Click"
                Style="{StaticResource UwpButtonStyle}"
                FontSize="18"
                Padding="0,0,0,3">

            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="0,4,4,0"/>
                </Style>
            </Button.Resources>

        </Button>

    </Grid>

</UserControl>