<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base -->
    <Color x:Key="WindowBackgroundColor">#F5F5F5</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="#F5F5F5"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryText" Color="#111111"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#666666"/>

    <!-- Accent -->
    <Color x:Key="AccentColor">#0078D7</Color>

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlBackground" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#E5E5E5"/>

    <!-- Interaction -->
    <SolidColorBrush x:Key="ControlHover" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#DADADA"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
</ResourceDictionary>