<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>
    <Color x:Key="ControlBackgroundColor">#2A2A2A</Color>
    <Color x:Key="ControlBorderColor">#3A3A3A</Color>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#AAAAAA"/>
    <!-- Accent -->
    <Color x:Key="AccentColor">#0078D7</Color>

    <SolidColorBrush x:Key="ControlBackground" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#3A3A3A"/>    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>


    <!-- Interaction -->
    <SolidColorBrush x:Key="ControlHover" Color="#353535"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#444444"/>

</ResourceDictionary>